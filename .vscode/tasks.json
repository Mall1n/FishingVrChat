{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build app",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/FishingVisionAssistant.App/FishingVisionAssistant.App.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run app",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/FishingVisionAssistant.App/FishingVisionAssistant.App.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
