<Application x:Class="FishingVisionAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101419" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#181E25" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2A333E" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F6F8" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#95A2AF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#39D98A" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="#26313B" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="#2B333C" />
      <Setter Property="Height" Value="6" />
    </Style>
  </Application.Resources>
</Application>
