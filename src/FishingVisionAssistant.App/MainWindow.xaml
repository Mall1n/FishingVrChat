<Window x:Class="FishingVisionAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fishing Vision Assistant"
        Width="1600"
        Height="860"
        MinWidth="1280"
        MinHeight="700"
        Background="{StaticResource WindowBackgroundBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock FontSize="26" FontWeight="SemiBold" Text="Fishing Vision Assistant" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Offline и live-анализ с визуальной рекомендацией без автоматизации ввода" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Click="OpenRecording_Click" Content="Открыть запись" />
        <Button x:Name="LiveCaptureButton"
                Margin="8,0,0,0"
                Click="LiveCapture_Click"
                Content="Запустить Live capture"
                IsEnabled="True"
                ToolTip="Выбрать окно VRChat или монитор через системный picker" />
        <Button x:Name="PauseLiveCaptureButton"
                Width="48"
                Margin="8,0,0,0"
                Click="PauseLiveCapture_Click"
                Content="▶"
                IsEnabled="False"
                Style="{StaticResource ReadableDisabledButtonStyle}"
                ToolTip="Live capture не запущен" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="350" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Padding="18" Background="{Binding AdviceBrush}" CornerRadius="8">
            <StackPanel>
              <TextBlock Foreground="#DDE5EB" Text="Рекомендация" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="32"
                         FontWeight="Bold"
                         Text="{Binding AdviceText}" />
              <TextBlock Margin="0,8,0,0"
                         Text="{Binding AdviceReason}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Источник" />
              <TextBlock Margin="0,10,0,0"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Text="{Binding SourceName}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding SourceName}" />
              <TextBlock Margin="0,6,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding SourceStatus}"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding SourcePath}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding SourcePath}" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Detector" />
              <TextBlock Margin="0,14,0,5" Text="Рамка мини-игры" />
              <ProgressBar Maximum="1" Value="{Binding PanelConfidence, Mode=OneWay}" />
              <TextBlock Margin="0,4,0,0"
                         HorizontalAlignment="Right"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding PanelConfidenceText}" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding PanelReason}"
                         TextWrapping="Wrap" />

              <TextBlock Margin="0,12,0,5" Text="Белая зона" />
              <ProgressBar Maximum="1" Value="{Binding WhiteZoneConfidence, Mode=OneWay}" />
              <TextBlock Margin="0,4,0,0"
                         HorizontalAlignment="Right"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding WhiteZoneConfidenceText}" />

              <TextBlock Margin="0,12,0,5" Text="Значок рыбы" />
              <ProgressBar Maximum="1" Value="{Binding FishConfidence, Mode=OneWay}" />
              <TextBlock Margin="0,4,0,0"
                         HorizontalAlignment="Right"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding FishConfidenceText}" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Frame Inspector" />
              <CheckBox x:Name="FrameInspectorSmoothingCheckBox"
                        Margin="0,10,0,0"
                        Checked="FrameInspectorSmoothing_Changed"
                        Content="Сглаживание · 1 с"
                        ToolTip="Показывает среднее значение latency и стадий pipeline за последнюю секунду. Сам pipeline не замедляется."
                        Unchecked="FrameInspectorSmoothing_Changed" />
              <DockPanel Margin="0,12,0,0">
                <TextBlock Text="Кадр" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding FramePosition}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Позиция" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding VideoPosition}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Pipeline FPS" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding PipelineFps}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Текущая latency" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding PipelineLatency}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0"
                         ToolTip="Offline: чтение кадра из видео. Live: копирование capture surface с GPU в CPU byte buffer, включая преобразование формата.">
                <TextBlock Text="{Binding InputLatencyLabel}" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding DecodeLatency}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0"
                         ToolTip="Время между готовностью CPU byte buffer и началом анализа detector. Для offline-видео не используется.">
                <TextBlock Text="Очередь (live)" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding QueueWaitLatency}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0"
                         ToolTip="Подготовка входа модели: BGRA/BGR-преобразование, letterbox, RGB-нормализация и создание tensor.">
                <TextBlock Text="Preprocess" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding PreprocessLatency}" />
              </DockPanel>
              <DockPanel Margin="0,6,0,0"
                         ToolTip="Преобразование захваченного BGRA32 кадра в BGR24 для OpenCV. Для offline-кадра уже используется BGR24.">
                <TextBlock Text="  BGRA → BGR" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding ColorConversionLatency}" />
              </DockPanel>
              <DockPanel Margin="0,6,0,0"
                         ToolTip="Изменение размера исходного кадра и добавление полей до размера входа YOLO.">
                <TextBlock Text="  Letterbox" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding LetterboxLatency}" />
              </DockPanel>
              <DockPanel Margin="0,6,0,0"
                         ToolTip="RGB-нормализация, перестановка каналов и копирование данных в ONNX tensor.">
                <TextBlock Text="  Tensor" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding TensorCreationLatency}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0"
                         ToolTip="Выполнение нейросети внутри ONNX Runtime: вызов InferenceSession.Run без подготовки и разбора результата.">
                <TextBlock Text="Inference" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding InferenceLatency}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0"
                         ToolTip="Разбор OBB, применение Gate, пересчёт координат и создание только выбранных preview PNG.">
                <TextBlock Text="Postprocess" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding PostprocessLatency}" />
              </DockPanel>
              <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Режим обработки" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding CacheStatus}" />
              </DockPanel>
              <TextBlock Margin="0,12,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding PerformanceSummary}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" />
          <RowDefinition Height="16" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <Grid>
            <Image x:Name="SourcePreviewImage"
                   Margin="12"
                   Source="{Binding SourcePreview}"
                   Stretch="Uniform" />
            <Canvas x:Name="LiveDetectionCanvas"
                    Margin="12"
                    Background="Transparent"
                    IsHitTestVisible="False" />
            <Canvas x:Name="AnnotationCanvas"
                    Margin="12"
                    Background="Transparent"
                    IsHitTestVisible="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="{Binding PreviewTitle}" />
              <TextBlock Margin="0,8,0,0"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding PreviewHint}" />
            </StackPanel>
            <Border Margin="12"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#B312171D"
                    CornerRadius="4">
              <TextBlock FontSize="12" Text="Исходный кадр + найденная рамка" />
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <Image Margin="10" Source="{Binding RectifiedPreview}" Stretch="Uniform" />
              <Border Margin="10"
                      Padding="7,3"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="#B312171D"
                      CornerRadius="4">
                <TextBlock FontSize="12" Text="Выпрямленная шкала" />
              </Border>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <Image Margin="10" Source="{Binding MaskPreview}" Stretch="Uniform" />
              <Border Margin="10"
                      Padding="7,3"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="#B312171D"
                      CornerRadius="4">
                <TextBlock FontSize="12" Text="{Binding DiagnosticPreviewTitle}" />
              </Border>
            </Grid>
          </Border>

          <Border Grid.Column="4"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <Image Margin="10" Source="{Binding TrainingBoundsPreview}" Stretch="Uniform" />
              <Border Margin="10"
                      Padding="7,3"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="#B312171D"
                      CornerRadius="4">
                <TextBlock FontSize="12" Text="Training bounds (OBB)" />
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="ONNX detector" />

              <Button x:Name="ChooseOnnxModelButton"
                      Margin="0,12,0,0"
                      Style="{StaticResource AnnotationButtonStyle}"
                      Click="ChooseOnnxModel_Click"
                      Content="Выбрать ONNX-модель" />
              <DockPanel Margin="0,10,0,0">
                <TextBlock VerticalAlignment="Center" Text="Backend" />
                <ComboBox x:Name="OnnxBackendComboBox"
                          Width="180"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Right"
                          SelectedIndex="0"
                          SelectionChanged="OnnxBackend_SelectionChanged"
                          Style="{StaticResource DarkComboBoxStyle}">
                  <ComboBoxItem Content="Auto (DirectML → CPU)" Tag="Auto" />
                  <ComboBoxItem Content="DirectML" Tag="DirectMl" />
                  <ComboBoxItem Content="CPU" Tag="Cpu" />
                </ComboBox>
              </DockPanel>
              <Button x:Name="ConfigureOnnxGateButton"
                      Margin="0,8,0,0"
                      Style="{StaticResource AnnotationButtonStyle}"
                      Click="ConfigureOnnxGate_Click"
                      Content="Настройки Gate" />
              <TextBlock x:Name="OnnxModelPathText"
                         Margin="0,6,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Модель не выбрана"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <TextBlock x:Name="OnnxDetectorStatusText"
                         Margin="0,8,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="ONNX-модель не загружена."
                         TextWrapping="Wrap" />
              <TextBlock x:Name="OnnxGateSummaryText"
                         Margin="0,7,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Gate: confidence ≥ 50 %, aspect ratio ≥ 10. Backend: Auto (DirectML → CPU)."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Отображение Live" />
              <CheckBox x:Name="PauseAllPreviewsCheckBox"
                        Margin="0,12,0,0"
                        Checked="LivePreviewSettings_Changed"
                        Content="Приостановить все preview"
                        Unchecked="LivePreviewSettings_Changed" />
              <TextBlock Margin="0,12,0,4"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Обновлять:" />
              <CheckBox x:Name="SourcePreviewCheckBox"
                        Margin="0,6,0,0"
                        IsChecked="True"
                        Checked="LivePreviewSettings_Changed"
                        Content="Исходный кадр"
                        Unchecked="LivePreviewSettings_Changed" />
              <CheckBox x:Name="RectifiedPreviewCheckBox"
                        Margin="0,6,0,0"
                        IsChecked="True"
                        Checked="LivePreviewSettings_Changed"
                        Content="Выпрямленная шкала"
                        Unchecked="LivePreviewSettings_Changed" />
              <CheckBox x:Name="OnnxDiagnosticPreviewCheckBox"
                        Margin="0,6,0,0"
                        IsChecked="True"
                        Checked="LivePreviewSettings_Changed"
                        Content="Диагностика ONNX"
                        Unchecked="LivePreviewSettings_Changed" />
              <DockPanel Margin="0,14,0,0">
                <TextBlock VerticalAlignment="Center" Text="Частота preview" />
                <ComboBox x:Name="LivePreviewIntervalComboBox"
                          Width="150"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Right"
                          SelectedIndex="2"
                          SelectionChanged="LivePreviewInterval_SelectionChanged"
                          Style="{StaticResource DarkComboBoxStyle}">
                  <ComboBoxItem Content="Каждый кадр" Tag="1" />
                  <ComboBoxItem Content="Каждый 2-й" Tag="2" />
                  <ComboBoxItem Content="Каждый 4-й" Tag="4" />
                  <ComboBoxItem Content="Каждый 8-й" Tag="8" />
                </ComboBox>
              </DockPanel>
              <TextBlock x:Name="PreviewSettingsSummaryText"
                         Margin="0,8,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Все preview · каждый 4-й обработанный кадр."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border
                  Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <DockPanel>
                <CheckBox x:Name="AnnotationModeCheckBox"
                          DockPanel.Dock="Right"
                          VerticalAlignment="Center"
                          Checked="AnnotationMode_Changed"
                          Content="Включён"
                          Unchecked="AnnotationMode_Changed" />
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="OBB-разметка" />
              </DockPanel>

              <Button Margin="0,12,0,0"
                      Style="{StaticResource AnnotationButtonStyle}"
                      Click="ChooseDatasetFolder_Click"
                      Content="Выбрать папку dataset" />
              <TextBlock x:Name="DatasetPathText"
                         Margin="0,6,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Папка не выбрана"
                         TextTrimming="CharacterEllipsis" />

              <DockPanel Margin="0,12,0,0">
                <TextBlock VerticalAlignment="Center" Text="Split" />
                <ComboBox x:Name="DatasetSplitComboBox"
                          Width="140"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Right"
                          SelectionChanged="DatasetSplit_SelectionChanged"
                          SelectedIndex="0"
                          Style="{StaticResource DarkComboBoxStyle}">
                  <ComboBoxItem Content="Train" Tag="Train" />
                  <ComboBoxItem Content="Validation" Tag="Validation" />
                  <ComboBoxItem Content="Test" Tag="Test" />
                </ComboBox>
              </DockPanel>
              <TextBlock Margin="0,5,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Одно исходное видео сохраняйте целиком в одном split."
                         TextWrapping="Wrap" />

              <Border Margin="0,10,0,0"
                      Padding="10,7"
                      Background="#202831"
                      BorderBrush="{StaticResource PanelBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <TextBlock x:Name="ExistingAnnotationText"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Текущий кадр ещё не проверен."
                           TextWrapping="Wrap" />
              </Border>

              <DockPanel Margin="0,10,0,0">
                <Button x:Name="PreviousAnnotationButton"
                        Width="142"
                        Margin="0,0,8,0"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="PreviousAnnotation_Click"
                        Content="◀ Предыдущая метка" />
                <Button x:Name="NextAnnotationButton"
                        Width="142"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="NextAnnotation_Click"
                        Content="Следующая метка ▶" />
              </DockPanel>
              <TextBlock x:Name="TimelineAnnotationCountText"
                         Margin="0,6,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Меток текущего видео: 0" />

              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="AcceptAnnotationButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="AcceptAnnotation_Click"
                        Content="[Enter] Принять" />
                <Button x:Name="CorrectAnnotationButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="CorrectAnnotation_Click"
                        Content="[E] Исправить" />
                <Button x:Name="ManualAnnotationButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="ManualAnnotation_Click"
                        Content="[M] Вручную" />
                <Button x:Name="NegativeAnnotationButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="NegativeAnnotation_Click"
                        Content="[N] Рамки нет" />
                <Button x:Name="DeleteAnnotationButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="DeleteAnnotation_Click"
                        Content="[Delete] Удалить" />
              </WrapPanel>

              <TextBlock x:Name="AnnotationStatusText"
                         Margin="0,4,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Включите режим и выберите dataset."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Обучение OBB-модели" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Используется выбранная выше папка dataset и .venv проекта."
                         TextWrapping="Wrap" />

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Epochs"
                           ToolTip="Максимальное число полных проходов модели по Train." />
                <TextBlock Grid.Column="2"
                           Text="Patience"
                           ToolTip="Остановка обучения после указанного числа эпох без улучшения Validation." />
                <TextBlock Grid.Column="4"
                           Text="Batch"
                           ToolTip="Число кадров в одном шаге. Значение -1 автоматически подбирает batch по памяти GPU." />
                <TextBox x:Name="TrainingEpochsTextBox"
                         Grid.Row="1"
                         Margin="0,5,0,0"
                         Style="{StaticResource DarkTextBoxStyle}"
                         ToolTip="Максимальное число полных проходов модели по Train. Для начала оставьте 150."
                         Text="150" />
                <TextBox x:Name="TrainingPatienceTextBox"
                         Grid.Row="1"
                         Grid.Column="2"
                         Margin="0,5,0,0"
                         Style="{StaticResource DarkTextBoxStyle}"
                         ToolTip="Если Validation не улучшается столько эпох, обучение завершается досрочно."
                         Text="35" />
                <TextBox x:Name="TrainingBatchTextBox"
                         Grid.Row="1"
                         Grid.Column="4"
                         Margin="0,5,0,0"
                         Style="{StaticResource DarkTextBoxStyle}"
                         ToolTip="-1 автоматически подбирает batch по доступной памяти GPU."
                         Text="-1" />
              </Grid>

              <DockPanel Margin="0,10,0,0">
                <TextBlock VerticalAlignment="Center" Text="Модель" />
                <ComboBox x:Name="TrainingModelComboBox"
                          Width="180"
                          HorizontalAlignment="Right"
                          SelectedIndex="0"
                          Style="{StaticResource DarkComboBoxStyle}">
                  <ComboBoxItem Content="YOLO26n OBB · быстро" Tag="yolo26n-obb.pt" ToolTip="Лёгкая стартовая модель для первого baseline." />
                  <ComboBoxItem Content="YOLO26s OBB · баланс" Tag="yolo26s-obb.pt" ToolTip="Более точная и более тяжёлая модель для второго запуска." />
                  <ComboBoxItem Content="YOLO26m OBB · точность" Tag="yolo26m-obb.pt" ToolTip="Требует больше памяти GPU и данных, чем n и s." />
                </ComboBox>
              </DockPanel>

              <DockPanel Margin="0,10,0,0">
                <TextBlock VerticalAlignment="Center" Text="Устройство" />
                <ComboBox x:Name="TrainingDeviceComboBox"
                          Width="160"
                          HorizontalAlignment="Right"
                          SelectedIndex="0"
                          Style="{StaticResource DarkComboBoxStyle}">
                  <ComboBoxItem Content="Auto (GPU)" Tag="auto" />
                  <ComboBoxItem Content="GPU 0" Tag="0" />
                  <ComboBoxItem Content="CPU" Tag="cpu" />
                </ComboBox>
              </DockPanel>

              <DockPanel Margin="0,10,0,0">
                <TextBlock VerticalAlignment="Center"
                           Text="Размер ONNX input"
                           ToolTip="Статическое разрешение входа экспортируемой ONNX-модели. Меньший размер ускоряет inference, но требует отдельной проверки качества." />
                <ComboBox x:Name="OnnxExportImageSizeComboBox"
                          Width="160"
                          HorizontalAlignment="Right"
                          SelectedIndex="0"
                          Style="{StaticResource DarkComboBoxStyle}">
                  <ComboBoxItem Content="1024 × 1024 · baseline" Tag="1024" />
                  <ComboBoxItem Content="768 × 768 · эксперимент" Tag="768" />
                  <ComboBoxItem Content="640 × 640 · эксперимент" Tag="640" />
                  <ComboBoxItem Content="512 × 512 · эксперимент" Tag="512" />
                </ComboBox>
              </DockPanel>

              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="CheckDatasetButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="CheckDataset_Click"
                        Content="Проверить dataset" />
                <Button x:Name="StartTrainingButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="StartTraining_Click"
                        Content="Начать обучение" />
                <Button x:Name="StopTrainingButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="StopTraining_Click"
                        Content="Остановить"
                        IsEnabled="False" />
                <Button x:Name="OpenTrainingLogButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="OpenTrainingLog_Click"
                        Content="Открыть журнал"
                        IsEnabled="False" />
                <Button x:Name="OpenTrainingResultFolderButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="OpenTrainingResultFolder_Click"
                        Content="Открыть результат"
                        IsEnabled="False" />
                <Button x:Name="ExportOnnxButton"
                        Margin="0,0,8,8"
                        Style="{StaticResource AnnotationButtonStyle}"
                        Click="ExportOnnx_Click"
                        Content="Экспортировать ONNX" />
              </WrapPanel>

              <TextBlock x:Name="TrainingStatusText"
                         Margin="0,2,0,0"
                         FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="Готово к проверке dataset или обучению. Размер входа: 1024 × 1024."
                         TextWrapping="Wrap" />
              <Border Margin="0,10,0,0"
                      Padding="8"
                      Background="#161D24"
                      BorderBrush="{StaticResource PanelBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      ToolTip="Последняя строка ML-процесса. Полный журнал открывается отдельной кнопкой.">
                <TextBlock x:Name="TrainingLastLogText"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="Журнал появится после запуска операции."
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
              </Border>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="4"
            Padding="12"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="7"
                   Margin="0,0,0,8"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="OBB: Enter принять · E исправить · M вручную · N рамки нет · Delete удалить · ←/→ 1 с · Shift+←/→ кадр" />

        <StackPanel Grid.Row="1" Orientation="Horizontal">
          <Button Click="PreviousSecond_Click"
                  IsEnabled="{Binding CanNavigate}"
                  Style="{StaticResource ReadableDisabledButtonStyle}"
                  Content="◀ 1 с"
                  ToolTip="Назад на одну секунду" />
          <Button Click="PreviousFrame_Click"
                  IsEnabled="{Binding CanNavigate}"
                  Style="{StaticResource ReadableDisabledButtonStyle}"
                  Content="◀" />
          <Button Click="PlayPause_Click"
                  IsEnabled="{Binding CanNavigate}"
                  Style="{StaticResource ReadableDisabledButtonStyle}"
                  Content="{Binding PlayPauseText}" />
          <Button Click="NextFrame_Click"
                  IsEnabled="{Binding CanNavigate}"
                  Style="{StaticResource ReadableDisabledButtonStyle}"
                  Content="▶" />
          <Button Click="NextSecond_Click"
                  IsEnabled="{Binding CanNavigate}"
                  Style="{StaticResource ReadableDisabledButtonStyle}"
                  Content="1 с ▶"
                  ToolTip="Вперёд на одну секунду" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="2">
          <Slider x:Name="TimelineSlider"
                  Margin="0,7,0,0"
                  IsEnabled="{Binding CanNavigate}"
                  IsMoveToPointEnabled="True"
                  Maximum="{Binding TimelineMaximum}"
                  Minimum="0"
                  PreviewMouseLeftButtonUp="Timeline_PreviewMouseLeftButtonUp"
                  Value="{Binding TimelineValue, Mode=OneWay}" />
          <Canvas x:Name="TimelineMarkersCanvas"
                  Height="9"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  SizeChanged="TimelineMarkersCanvas_SizeChanged" />
        </Grid>
        <StackPanel Grid.Row="1" Grid.Column="4" VerticalAlignment="Center">
          <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource PrimaryTextBrush}">
            <Run Text="Кадр " />
            <Run Text="{Binding FramePosition, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Margin="0,2,0,0"
                     HorizontalAlignment="Right"
                     FontSize="11"
                     Foreground="{StaticResource SecondaryTextBrush}"
                     Text="{Binding VideoPosition}" />
        </StackPanel>
        <Button Grid.Column="6"
                Grid.Row="1"
                Width="76"
                Margin="0"
                Click="PlaybackSpeed_Click"
                Content="{Binding PlaybackSpeedText}"
                IsEnabled="{Binding CanNavigate}"
                Style="{StaticResource ReadableDisabledButtonStyle}"
                ToolTip="Нажмите, чтобы изменить скорость воспроизведения" />
      </Grid>
    </Border>
  </Grid>
</Window>
