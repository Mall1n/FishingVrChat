<Window x:Class="FishingVisionAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Fishing Vision Assistant"
        Width="1380"
        Height="860"
        MinWidth="1080"
        MinHeight="700"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock FontSize="26" FontWeight="SemiBold" Text="Fishing Vision Assistant" />
        <TextBlock Margin="0,4,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Offline-анализ и визуальная рекомендация без автоматизации ввода" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
        <Button Click="OpenRecording_Click" Content="Открыть запись" />
        <Button IsEnabled="False"
                ToolTip="Live capture будет подключён на следующем этапе"
                Content="Выбрать источник экрана" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="350" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="2*" />
          <RowDefinition Height="16" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <Grid>
            <Image Margin="12" Source="{Binding SourcePreview}" Stretch="Uniform" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Text="{Binding PreviewTitle}" />
              <TextBlock Margin="0,8,0,0"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding PreviewHint}" />
            </StackPanel>
            <Border Margin="12"
                    Padding="8,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#B312171D"
                    CornerRadius="4">
              <TextBlock FontSize="12" Text="Исходный кадр + найденная рамка" />
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <Image Margin="10" Source="{Binding RectifiedPreview}" Stretch="Uniform" />
              <Border Margin="10"
                      Padding="7,3"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="#B312171D"
                      CornerRadius="4">
                <TextBlock FontSize="12" Text="Выпрямленная шкала" />
              </Border>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <Image Margin="10" Source="{Binding MaskPreview}" Stretch="Uniform" />
              <Border Margin="10"
                      Padding="7,3"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="#B312171D"
                      CornerRadius="4">
                <TextBlock FontSize="12" Text="HSV-маска рамки" />
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Padding="18" Background="{Binding AdviceBrush}" CornerRadius="8">
            <StackPanel>
              <TextBlock Foreground="#DDE5EB" Text="Рекомендация" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="32"
                         FontWeight="Bold"
                         Text="{Binding AdviceText}" />
              <TextBlock Margin="0,8,0,0"
                         Text="{Binding AdviceReason}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Источник" />
              <TextBlock Margin="0,10,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding SourceStatus}"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,6,0,0"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding SourcePath}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Detector" />
              <TextBlock Margin="0,14,0,5" Text="Рамка мини-игры" />
              <ProgressBar Maximum="1" Value="{Binding PanelConfidence, Mode=OneWay}" />
              <TextBlock Margin="0,4,0,0"
                         HorizontalAlignment="Right"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding PanelConfidenceText}" />
              <TextBlock Margin="0,8,0,0"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding PanelReason}"
                         TextWrapping="Wrap" />

              <TextBlock Margin="0,12,0,5" Text="Белая зона" />
              <ProgressBar Maximum="1" Value="{Binding WhiteZoneConfidence, Mode=OneWay}" />
              <TextBlock Margin="0,4,0,0"
                         HorizontalAlignment="Right"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding WhiteZoneConfidenceText}" />

              <TextBlock Margin="0,12,0,5" Text="Значок рыбы" />
              <ProgressBar Maximum="1" Value="{Binding FishConfidence, Mode=OneWay}" />
              <TextBlock Margin="0,4,0,0"
                         HorizontalAlignment="Right"
                         FontSize="12"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Text="{Binding FishConfidenceText}" />
            </StackPanel>
          </Border>

          <Border Margin="0,14,0,0"
                  Padding="18"
                  Background="{StaticResource PanelBackgroundBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Кадр" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FramePosition}" />
              <TextBlock Grid.Row="2" Text="Pipeline FPS" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PipelineFps}" />
              <TextBlock Grid.Row="4" Text="Задержка" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PipelineLatency}" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="4"
            Padding="12"
            Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal">
          <Button IsEnabled="False" Content="◀ 10" />
          <Button IsEnabled="False" Content="◀" />
          <Button IsEnabled="False" Content="▶" />
          <Button IsEnabled="False" Content="10 ▶" />
        </StackPanel>

        <Slider Grid.Column="2" IsEnabled="False" Minimum="0" Maximum="1" Value="0" />
        <TextBlock Grid.Column="4"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Покадровый decoder будет подключён на следующем этапе" />
      </Grid>
    </Border>
  </Grid>
</Window>
