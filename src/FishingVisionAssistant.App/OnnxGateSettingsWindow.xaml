<Window x:Class="FishingVisionAssistant.App.OnnxGateSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки ONNX Gate"
        Width="460"
        Height="330"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
  <Border Margin="18"
          Padding="20"
          Background="{StaticResource PanelBackgroundBrush}"
          BorderBrush="{StaticResource PanelBorderBrush}"
          BorderThickness="1"
          CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Deployment Gate" />
        <TextBlock Margin="0,7,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Кандидат принимается только при выполнении обоих условий."
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,20,0,0">
        <DockPanel>
          <TextBlock Text="Минимальный confidence" />
          <TextBlock x:Name="ConfidenceValueText"
                     HorizontalAlignment="Right"
                     FontWeight="SemiBold" />
        </DockPanel>
        <Slider x:Name="ConfidenceSlider"
                Margin="0,5,0,0"
                Minimum="0.05"
                Maximum="0.95"
                TickFrequency="0.01"
                IsSnapToTickEnabled="True"
                ValueChanged="GateSlider_ValueChanged" />
      </StackPanel>

      <StackPanel Grid.Row="2" Margin="0,18,0,0">
        <DockPanel>
          <TextBlock Text="Минимальный aspect ratio" />
          <TextBlock x:Name="AspectRatioValueText"
                     HorizontalAlignment="Right"
                     FontWeight="SemiBold" />
        </DockPanel>
        <Slider x:Name="AspectRatioSlider"
                Margin="0,5,0,0"
                Minimum="1"
                Maximum="30"
                TickFrequency="0.1"
                IsSnapToTickEnabled="True"
                ValueChanged="GateSlider_ValueChanged" />
      </StackPanel>

      <TextBlock Grid.Row="3"
                 Margin="0,16,0,0"
                 Foreground="{StaticResource SecondaryTextBrush}"
                 Text="Снижение порогов повышает recall, но может добавить false positives. Исходные значения baseline: 50 % и 10,0."
                 TextWrapping="Wrap" />

      <DockPanel Grid.Row="4" Margin="0,18,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Left"
                Margin="0"
                Click="ResetDefaults_Click"
                Content="Сбросить" />
        <Button DockPanel.Dock="Right"
                Margin="8,0,0,0"
                IsDefault="True"
                Click="Apply_Click"
                Content="Применить" />
        <Button DockPanel.Dock="Right"
                Margin="0"
                IsCancel="True"
                Content="Отмена" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
